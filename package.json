{
  "name": "caspian-pos",
  "version": "1.0.0",
  "description": "Caspian POS desktop app",
  "main": "main.js",
  "author": "Caspian",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.caspian.pos",
    "publish": null,
    "productName": "Caspian POS",
    "files": [
      "main.js",
      "delivery342.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
